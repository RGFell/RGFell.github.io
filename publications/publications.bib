% Single source of truth for the Publications and Reports pages.
% Add one record here and re-render; _scripts/build_publications.py does the rest.
%
% Entry type decides the section:
%   @article        -> Publications: Journal articles
%   @unpublished    -> Publications: Preprints
%   @inproceedings  -> Publications: Conference papers and abstracts
%   @incollection   -> Publications: Book chapters
%   @techreport     -> Reports
%   @phdthesis      -> Publications: Theses (last section)
%
% Home page "Selected publications" cards (read by the build script, ignored by APA):
%   keywords = {featured}   show this entry as a card on Home (aim for 5-6)
%   tag      = {Sea ice}    short topic label on the card
%   summary  = {...}        one plain-language sentence
%   image    = {images/pubs/<key>.jpg}   optional figure; without it the card shows the journal name
%   imagealt = {...}        alt text for that figure (required if the image carries information)
%   imagecredit = {...}     source or credit line shown under the card (e.g. data provider)
%
% Sources: DOI entries use Crossref metadata (via doi.org); others come from the
% classic CV or the Google Scholar profile. Never add a field you cannot source.

